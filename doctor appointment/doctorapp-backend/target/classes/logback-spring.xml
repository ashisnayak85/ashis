<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Same rolling-file convention as the enterprise-employee-management backend:
         a logs/ folder at the project root, one rolling "app" log with everything,
         and a separate "error" log with just WARN+/ERROR+ so problems are easy to
         spot without wading through INFO/DEBUG noise. -->

    <property name="LOG_DIR" value="logs" />
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />

    <!-- Console - same as before, for local `mvn spring-boot:run` output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- logs/doctorapp.log - everything at the configured level, rotated daily
         and once it passes 10MB, kept for 14 days / 100MB total. -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/doctorapp.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/doctorapp-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- logs/doctorapp-error.log - WARN and above only, so exceptions (like the
         GlobalExceptionHandler.handleGeneric catch-all) are quick to find. -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/doctorapp-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/doctorapp-error-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
        <appender-ref ref="ERROR_FILE" />
    </root>

    <!-- Keep the app's own package at DEBUG (matches the previous
         logging.level.com.doctorapp=DEBUG in application.properties) -->
    <logger name="com.doctorapp" level="DEBUG" />

    <!-- Hibernate's SQL/bind-parameter logging still goes through
         spring.jpa.show-sql - this just makes sure it isn't muted by root level. -->
    <logger name="org.hibernate.SQL" level="DEBUG" />
</configuration>
