# =============================================================================
# OrgSite Platform - multi-tenant marketing site builder backend
# Every business (tea shop, restaurant, school, ...) is one "Organization" row.
# Public visitors hit /api/public/**  (no login).
# Business owners log in and manage their own content under /api/admin/**.
# =============================================================================

spring.application.name=orgsite-platform
server.port=8083

# --- Database ---
# Default: H2 in-memory so you can run this immediately with zero setup.
# For real use, comment the H2 block out and uncomment the MySQL block below.
spring.datasource.url=jdbc:h2:mem:orgsite_db;DB_CLOSE_DELAY=-1
spring.datasource.driver-class-name=org.h2.Driver
spring.datasource.username=sa
spring.datasource.password=
spring.h2.console.enabled=true
spring.h2.console.path=/h2-console

# --- MySQL (production) ---
# spring.datasource.url=jdbc:mysql://localhost:3306/orgsite_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.username=root
# spring.datasource.password=root
# spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# --- JWT ---
# Change this secret before any real deployment. Must be >= 256 bits for HS256.
app.jwt.secret=${JWT_SECRET:change-this-super-secret-key-before-deploying-orgsite-32bytes}
app.jwt.access-token-expiry-ms=28800000
# 8 hours - admins are business owners logging in occasionally, not needing 15-min tokens
app.jwt.refresh-token-expiry-ms=2592000000
# 30 days

# --- CORS ---
app.frontend-url=http://localhost:5175

# --- File uploads (logos, cover images, gallery photos) ---
# Stored on local disk under this folder and served back at /uploads/**
app.upload.dir=uploads
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# --- Logging ---
logging.level.root=INFO
logging.level.com.orgsite=DEBUG
