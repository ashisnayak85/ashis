<?xml version="1.0" encoding="UTF-8"?>
<!--
  LOGBACK CONFIGURATION (Phase 10)
  Logback is the default logging framework in Spring Boot
  
  LOG LEVELS (least to most severe):
  TRACE -> DEBUG -> INFO -> WARN -> ERROR
  
  STRATEGY:
  - INFO: Production default - business events, startup
  - DEBUG: Development - detailed flow tracing
  - WARN: Recoverable issues - validation failures, retries
  - ERROR: Unrecoverable - exceptions, system failures
-->
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- File Appender - rolling daily -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/eems.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/eems.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Application-specific loggers -->
    <logger name="com.enterprise.ems" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate.SQL" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
